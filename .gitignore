# --- Godot ---
**/.godot/
**/*.translation.orig
build/
*.tpz

# --- Python (offline tools only; the backend is retired) ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# local API state: drafts, the fact-check queue and the usage ledger
apps/server/data/

# --- bun (admin SPA) ---
node_modules/
# build outputs are artifacts — `bun run build` recreates them
apps/*/dist/
# the admin SPA builds into the API's public directory and is served statically from there
apps/server/public/admin/
# bun is the only package manager (docs/PLAN.md §10.6):
# any of these appearing means someone ran npm/yarn/pnpm by mistake.
package-lock.json
yarn.lock
pnpm-lock.yaml
*.lockb

# --- secrets (docs/PLAN.md §3) ---
.env
.env.*
!.env.example
*_credentials.json

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- agent tooling (AtomCode hooks/MCP/skills are per-machine, not project source) ---
.atomcode/

# --- browser verification (playwright-cli snapshots/logs are run output) ---
.playwright-cli/
