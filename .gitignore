# --- Godot ---
**/.godot/
**/*.translation.orig
build/
*.tpz

# --- Python (backend) ---
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
server/data/

# --- bun (admin SPA) ---
node_modules/
# build outputs are artifacts — CI and `bun run build` recreate them
server/admin/dist/
apps/*/dist/
# bun is the only package manager (docs/PLAN.md §10.6):
# any of these appearing means someone ran npm/yarn/pnpm by mistake.
package-lock.json
yarn.lock
pnpm-lock.yaml
*.lockb

# --- secrets (docs/PLAN.md §3) ---
.env
.env.*
!.env.example
*_credentials.json

# --- OS / editors ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# --- agent tooling (AtomCode hooks/MCP/skills are per-machine, not project source) ---
.atomcode/

# --- browser verification (playwright-cli snapshots/logs are run output) ---
.playwright-cli/
