  "npcs": [],
  "doors": [],
  "interactables": [
    {
      "id": "the_box",
      "tile": [6, 2],
      "prompt": { "zh_HK": "打開屋企個箱", "zh_CN": "打开家里的箱子", "en": "Open the family box" },
      "requires": { "all": [
        { "quest_done": "ch02" },
        { "quest_done": "ch03" },
        { "quest_done": "ch04" },
        { "quest_done": "ch05" }
      ] },
      "on_interact": [
        { "type": "quest", "quest": "ch06", "op": "start" }
      ],
      "_comment": "The finale trigger (§12.2: decide what the box is for) — appears only after all four journeys are complete."
    },
    {
      "id": "box_on_the_altar",
      "tile": [8, 2],
      "once": true,
      "prompt": { "zh_HK": "打開神枱上的木箱", "zh_CN": "打开神龛上的木箱", "en": "Open the box on the altar" },
      "on_interact": [
        { "type": "give", "item": "item_photo_album", "count": 1 },
        {
          "type": "say",
          "text": {
            "zh_HK": "木箱入面有本黑皮相簿，繩結已經鬆開。",
            "zh_CN": "木箱里有一本黑皮相簿，绳结已经松开。",
            "en": "Inside the box: a black photo album, its tie-string loose."
          }
        }
      ]
    },
    {
      "id": "chest_drawer",
      "tile": [13, 2],
      "once": true,
      "prompt": { "zh_HK": "拉開五斗櫃抽屜", "zh_CN": "拉开五斗柜抽屉", "en": "Open the chest drawer" },
      "on_interact": [
        { "type": "give", "item": "item_unsent_letter", "count": 1 },
        {
          "type": "say",
          "text": {
            "zh_HK": "抽屜底有一封信，封咗口，冇貼郵票。",
            "zh_CN": "抽屉底有一封信，封了口，没有贴邮票。",
            "en": "At the bottom of the drawer: a sealed letter, never stamped."
          }
        }
      ]
    },
    {
      "id": "old_radio",
      "tile": [2, 2],
      "once": true,
      "prompt": { "zh_HK": "挪開收音機", "zh_CN": "挪开收音机", "en": "Move the radio" },
      "on_interact": [
        { "type": "give", "item": "item_cassette_tape", "count": 1 },
        {
          "type": "say",
          "text": {
            "zh_HK": "收音機後面有一卷卡式帶。",
            "zh_CN": "收音机后面有一卷卡式磁带。",
            "en": "Behind the radio: a cassette tape."
          }
        }
      ]
    },
    {
      "id": "jacket_pocket",
      "tile": [11, 8],
      "once": true,
      "prompt": { "zh_HK": "搜外套口袋", "zh_CN": "搜外套口袋", "en": "Search the jacket pocket" },
      "on_interact": [
        { "type": "give", "item": "item_tram_ticket", "count": 1 },
        {
          "type": "say",
          "text": {
            "zh_HK": "外套口袋有一張尾班電車票根。",
            "zh_CN": "外套口袋里有一张末班电车票根。",
            "en": "In the jacket pocket: a last-tram ticket stub."
          }
        }
      ]
    },
    {
      "id": "shoe_cabinet",
      "tile": [13, 8],
      "once": true,
      "prompt": { "zh_HK": "打開鞋櫃上的銀包", "zh_CN": "打开鞋柜上的钱包", "en": "Open the wallet on the shoe cabinet" },
      "on_interact": [
        { "type": "give", "item": "item_octopus_card", "count": 1 },
        {
          "type": "say",
          "text": {
            "zh_HK": "銀包裡面有張舊八達通。",
            "zh_CN": "钱包里有一张旧八达通。",
            "en": "Inside the wallet: an old Octopus card."
          }
        }
      ]
    },
    {
      "id": "kitchen_table",
      "tile": [9, 6],
      "once": true,
      "prompt": { "zh_HK": "執起枱面張收據", "zh_CN": "捡起桌上的收据", "en": "Pick up the receipt" },
      "on_interact": [
        { "type": "give", "item": "item_tea_receipt", "count": 1 },
        {
          "type": "say",
          "text": {
            "zh_HK": "枱面有張收據，日期畀人用鉛筆圈起咗。",
            "zh_CN": "桌上有一张收据，日期被人用铅笔圈了起来。",
            "en": "On the table: a receipt with the date circled in pencil."
          }
        }
      ]
    }
  ],
  "exits": [
    {
      "id": "to_street",
      "rect": [0, 4, 1, 3],
      "to": "loc_ssp_market_street",
      "spawn": "from_flat"
    }
  ],
  "_comment": "The family flat being emptied (PLAN §12.2): object interactions carry five of the eight mementos; the album is the chapter-2 door."
}
