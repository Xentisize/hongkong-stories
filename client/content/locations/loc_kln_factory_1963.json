      "on_interact": [
        {
          "type": "say",
          "text": {
            "zh_HK": "梭仔打成一片，棉絮喺光裡面浮。企得耐，連講嘢都要嗌。",
            "zh_CN": "梭子打成一片，棉絮在光里浮。站久了，连说话都要喊。",
            "en": "The shutters beat as one; cotton dust hangs in the light. Stand here long enough and even talking becomes shouting."
          }
        }
      ]
    },
