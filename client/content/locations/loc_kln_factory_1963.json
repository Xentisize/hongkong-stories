      "id": "piecework_bale",
      "tile": [17, 4],
      "prompt": { "zh_HK": "望下布捆", "zh_CN": "看看布捆", "en": "The cloth bale" },
      "on_interact": [
        {
          "type": "say",
          "text": {
            "zh_HK": "一捆布等收貨，上面攤住未剪嘅線頭——屋企做嘅工，就係由呢度拎出去。",
            "zh_CN": "一捆布等着收货，上面摊着未剪的线头——家里做的工，就是从这里领出去的。",
            "en": "A bale waits for inspection, thread-ends trimmed and left — the piecework families took home starts from here."
          }
        }
      ]
    }
