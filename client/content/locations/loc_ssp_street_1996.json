      "tile": [10, 3],
      "prompt": { "zh_HK": "望下倒數牌", "zh_CN": "看看倒数牌", "en": "Read the countdown board" },
      "on_interact": [
        {
          "type": "say",
          "text": {
            "zh_HK": "大廈外牆掛住倒數牌，減到三位數。有人行過抬頭望一眼，有人刻意唔望。",
            "zh_CN": "大厦外墙上挂着倒数牌，减到三位数。有人走过抬头看一眼，有人刻意不看。",
            "en": "A countdown board hangs on the building wall, down to three digits. Some look up as they pass; some make a point of not looking."
          }
        }
      ]
    },
    {
      "id": "closed_shutter",
      "tile": [19, 9],
      "prompt": { "zh_HK": "望下捲閘", "zh_CN": "看看卷闸", "en": "Look at the shutter" },
      "on_interact": [
        {
          "type": "say",
          "text": {
            "zh_HK": "又一間舖拉咗閘，鐵閘上用粉筆寫住「旺舖招頂」。唔係唔旺，係人去咗遠處。",
            "zh_CN": "又一间铺拉了闸，铁闸上用粉笔写着「旺铺招顶」。不是不旺，是人去了远处。",
            "en": "Another shutter down, chalked with TO LET on the iron. It is not that business was bad — the people simply went somewhere far."
          }
        }
      ]
    }
