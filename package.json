{
  "name": "hongkong-stories",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "workspaces": [
    "packages/*",
    "admin",
    "apps/*"
  ],
  "scripts": {
    "test": "bun test",
    "check": "bun run --filter '*' check",
    "db:migrate": "bun run --filter '@hkstories/server' db:migrate",
    "demo:build": "bun tools/assemble_demo.ts",
    "demo": "bun tools/assemble_demo.ts && bun run --filter '@hkstories/server' dev",
    "content:check": "bun tools/check_content.ts",
    "content:manifest": "bun tools/gen_content_manifest.ts"
  },
  "dependencies": {
    "@hkstories/core": "workspace:*",
    "sharp": "^0.35.5"
  }
}
